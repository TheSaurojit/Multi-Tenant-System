# =============================================================================
# Environment variables for Multi-Tenant SaaS Analytics Dashboard
# =============================================================================

# PostgreSQL Database Connection (Local Docker, Neon, Supabase, etc.)
DATABASE_URL="postgresql://saas_user:saas_password@localhost:5432/saas_analytics?schema=public"

# App & Authentication Secrets
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="your-strong-random-jwt-secret-min-32-chars"

# -----------------------------------------------------------------------------
# Stripe Configuration (Test Mode)
# Replace placeholder values with keys from your Stripe Dashboard
# -----------------------------------------------------------------------------
# Stripe Secret Key (Dashboard -> Developers -> API keys -> Secret key)
STRIPE_SECRET_KEY="sk_test_placeholder_key"

# Stripe Publishable Key (Dashboard -> Developers -> API keys -> Publishable key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"

# Stripe Webhook Secret (Run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` to obtain)
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# Stripe Recurring Price IDs (Dashboard -> Product catalog -> Select product -> Pricing table)
# Pro Plan (Monthly Recurring, e.g. ₹1,499/mo)
STRIPE_PRO_PRICE_ID="price_mock_pro_monthly"

# Advanced Plan (Monthly Recurring, e.g. ₹4,999/mo)
STRIPE_ADVANCED_PRICE_ID="price_mock_advanced_monthly"

# -----------------------------------------------------------------------------
# Resend Transactional Email Configuration
# Optional in local development (falls back to logging formatted emails to console)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_placeholder_api_key"
RESEND_FROM_EMAIL="SaaS Analytics <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# Reverse Proxy & Client IP Configuration (REQUIRED in Production / Docker / VPS)
# Specify the header your reverse proxy / CDN uses to forward the real client IP:
# - Cloudflare: "cf-connecting-ip"
# - Nginx / Traefik: "x-real-ip" or "x-forwarded-for"
# - AWS ALB / GCP Cloud Armor: "x-forwarded-for"
# Note: On Vercel, this is automatically detected via "x-vercel-forwarded-for".
# In production, startup fails if this is unset (unless VERCEL or ALLOW_UNTRUSTED_IPS is set).
# -----------------------------------------------------------------------------
TRUSTED_IP_HEADER="x-forwarded-for"

# Force HTTPS security headers (Strict-Transport-Security, upgrade-insecure-requests CSP)
# Set to "true" when running behind a TLS-terminating reverse proxy (Nginx, Caddy, Cloudflare)
# Automatically enabled if NEXT_PUBLIC_APP_URL begins with "https://".
FORCE_HTTPS="false"



